{
  "expo": {
    "name": "SilverBack Sentry",
    "slug": "silverback-sentry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2c5f2d"
    },
    "android": {
      "package": "com.yourcompany.silverbacksentry",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.yourcompany.silverbacksentry",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "798ce32d-838f-4b02-a514-9ff558ae595d"
      }
    }
  }
}
